   "cell_type": "code",
   "source": [
    "x = 1.0/10\n",
    "for n in range(1, 50):\n",
    "    if x<= 0.5:\n",
    "        x = 2 * x\n",
    "        x = round(x, 2)\n",
    "    else:\n",
    "        x = (2 * x) - 1\n",
    "        x = round(x, 2)\n",
    "\n",
    "    print(f\"x{n} = {x}\")"
   ],
